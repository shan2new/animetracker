# Gradle / Android build outputs. Regenerated by `./gradlew`; never committed.
build/
*/build/
.gradle/
.cxx/

# Machine-local SDK location — written by the tooling, differs per machine.
local.properties

# Gradle's own caches and per-user config
.gradletasknamecache
gradle-app.setting

# Android Studio / IntelliJ (the project builds from the CLI; no IDE files are checked in,
# matching the iOS side's rule that the generated .xcodeproj stays out of git)
.idea/
*.iml
captures/

# Signing material. A keystore or its passwords must never reach the repository.
*.jks
*.keystore
keystore.properties
signing.properties

# Crash/profiling artefacts
*.hprof
