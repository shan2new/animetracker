<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon. minSdk is 26, which is exactly where adaptive icons arrive, so there is no
     legacy square/round fallback to maintain. `monochrome` drives Android 13+ themed icons; that
     layer has no iOS counterpart and is derived from the foreground silhouette. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@mipmap/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_monochrome" />
</adaptive-icon>
