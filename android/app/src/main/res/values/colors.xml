<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- ThemeColor.canvas — the one app ground. Mirrors ios ThemeTokens.swift. -->
    <color name="canvas">#FF09090B</color>

    <!--
      The LAUNCH frame: the canvas, and nothing else. The platform draws its splash — the adaptive
      icon in a disc on this colour — and `ui/shell/LaunchIdent.kt` starts from that exact picture,
      so the ground must be `canvas` (#09090B), the colour every screen stands on: any other value
      is a colour step on the app's very first frame. (It was true black once, for an ident that
      had a black base of its own; that ident is gone.)
    -->
    <color name="launch_background">#FF09090B</color>
</resources>
