<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG ONLY. The Android analogue of iOS's `NSAppTransportSecurity.NSAllowsLocalNetworking`:
  cleartext HTTP to a dev server on this desk, and nowhere else. Production is HTTPS, and the
  release build carries no network-security config at all — at targetSdk 36 the platform default
  already forbids cleartext everywhere.

  `10.0.2.2` is the emulator's alias for the host machine's loopback (`localhost` inside an emulator
  is the emulated device itself), and it is the debug build's default `API_BASE_URL`. `10.0.2.3` is
  the emulator's alias for the host's DNS server, listed because a proxy recipe occasionally uses
  it; `localhost` / `127.0.0.1` cover a server running on the device or forwarded with
  `adb reverse`.

  Android's network-security config matches by DOMAIN and cannot express a CIDR range, so pointing a
  debug build at a LAN address (`192.168.x.y`, the self-hosted Mac mini) needs that host added here
  by hand. iOS gets the whole private range from one boolean; this is the cost of the native
  mechanism and it is a deliberate trade rather than an oversight. `AppConfig.isLocalBackend` still
  recognises the full RFC-1918 space, so the `dev:` bearer boundary is unaffected.

  There is deliberately no `<base-config cleartextTrafficPermitted="true">`: a blanket opt-in in a
  debug build is how a plaintext production request goes unnoticed for a month.
-->
<network-security-config>
    <domain-config cleartextTrafficPermitted="true">
        <domain includeSubdomains="false">10.0.2.2</domain>
        <domain includeSubdomains="false">10.0.2.3</domain>
        <domain includeSubdomains="false">localhost</domain>
        <domain includeSubdomains="false">127.0.0.1</domain>
    </domain-config>
</network-security-config>
